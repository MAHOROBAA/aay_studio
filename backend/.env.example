# docs/spec/spec-addendum-backend.md 26.2 참고. 실제 값은 backend/.env(gitignore 처리됨)에 채운다.

APP_MODE=private_beta
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=none

PORT=8080

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_AI_API_KEY=
AI_TEXT_PROVIDER=google
AI_TEXT_MODEL=gemini-3.1-flash-lite
AI_IMAGE_PROVIDER=google
AI_IMAGE_MODEL=gemini-3.1-flash-image
AI_VIDEO_PROVIDER=google
AI_VIDEO_MODEL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

DAILY_AI_COST_LIMIT_USD=
MONTHLY_AI_COST_LIMIT_USD=
VIDEO_GENERATION_DAILY_LIMIT_PER_USER=

# 텍스트 생성(세계관/스토리) 원가·크레딧 계산용. 실제 청구 단가/환율에 맞춰 주기적으로 갱신한다.
AI_TEXT_INPUT_COST_PER_1M_USD=
AI_TEXT_OUTPUT_COST_PER_1M_USD=
USD_KRW_EXCHANGE_RATE=
# 실제 비용을 알기 전 미리 예약해두는 크레딧 상한(호출 후 실비용만큼 확정하고 나머지는 환불한다).
AI_TEXT_RESERVE_CREDIT_WORLD=
AI_TEXT_RESERVE_CREDIT_STORY=

# 이미지 생성(캐릭터/장면) 원가·크레딧 계산용. 출력 이미지 1장당 고정 단가로 계산한다.
AI_IMAGE_COST_PER_IMAGE_USD=
AI_IMAGE_RESERVE_CREDIT_CHARACTER=
AI_IMAGE_RESERVE_CREDIT_SCENE=
