# Google Analytics 4 웹 데이터 스트림의 측정 ID (형식: G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# 백엔드(backend/) API 기본 주소 (로컬: http://localhost:8080, 배포: Cloud Run URL)
VITE_API_BASE_URL=

# Supabase 프로젝트 URL과 anon(public) key. service_role key는 절대 여기 넣지 않는다 — backend/.env 전용.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
